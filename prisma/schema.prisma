// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}



enum Role {
  DOCTOR
  PATIENT
}

model User{
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name String 
  email String @unique
  phone_Number String @unique
  role Role @default(PATIENT)

  patient   Patient? 
  doctor   Doctor? 
  createdAt DateTime @default(now())  
  updatedAt DateTime @updatedAt
}
model Surgery{
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  description String
  createdAt DateTime @default(now())  
  updatedAt DateTime @updatedAt
  PatientId String @unique @db.ObjectId
  patient   Patient   @relation(fields: [PatientId], references: [id]) 
}
model Patient{
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  historySurgery Surgery[]
  historyillness String[]
 prescriptions DoctorPrescriptions[]  @relation("PatientPrescriptions")
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id]) 
}

model Doctor{
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  specialty String
 experience Float 
 prescriptions DoctorPrescriptions[]  @relation("DoctorPrescriptions")
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id]) 
}
model DoctorPrescriptions{
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  doctor     Doctor   @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  doctorId   String   @db.ObjectId
  patient     Patient   @relation("PatientPrescriptions", fields: [patiendId], references: [id])
  patiendId   String   @db.ObjectId
  createdAt DateTime @default(now())  
  updatedAt DateTime @updatedAt
}


